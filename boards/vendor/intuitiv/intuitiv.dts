/dts-v1/;
#include <st/f4/stm32f412Xg.dtsi>
#include <st/f4/stm32f412r(e-g)tx-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	model = "Intuitiv pilot-wire gateway";
	compatible = "vendor,intuitiv";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &usart1;
		zephyr,shell-uart = &usart1;
		zephyr,bt-hci = &bt_hci_uart;
		zephyr,settings-partition = &storage_partition;
	};

	/* RGB LED, active low. Colour of each pin not identified yet. */
	leds {
		compatible = "gpio-leds";

		led_red: led_red {
			gpios = <&gpiob 13 GPIO_ACTIVE_LOW>;
			label = "RGB LED red (PB13)";
		};

		led_green: led_green {
			gpios = <&gpiob 14 GPIO_ACTIVE_LOW>;
			label = "RGB LED green (PB14)";
		};

		led_blue: led_blue {
			gpios = <&gpiob 15 GPIO_ACTIVE_LOW>;
			label = "RGB LED blue (PB15)";
		};
	};

	/* Polarity not measured yet: assumed active low */
	buttons {
		compatible = "gpio-keys";

		button_middle: button_middle {
			gpios = <&gpiob 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
			label = "Middle button (PB5)";
			zephyr,code = <INPUT_KEY_0>;
		};

		button_pairing: button_pairing {
			gpios = <&gpioc 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
			label = "Hidden pairing reset button (PC2)";
			zephyr,code = <INPUT_KEY_1>;
		};
	};

	/* AP6212 LPO (pin 24): its Bluetooth core answers nothing but HCI_Reset without it */
	ap6212_lpo: ap6212-lpo {
		compatible = "pwm-clock";
		#clock-cells = <1>;
		pwms = <&pwm2 3 PWM_HZ(32768) PWM_POLARITY_NORMAL>;
	};

	/* Pilot-wire output: optotriac cathode switch and mains zero-cross */
	zephyr,user {
		opto-gpios = <&gpioc 6 GPIO_ACTIVE_HIGH>;
		zero-cross-gpios = <&gpioc 7 GPIO_ACTIVE_HIGH>;
	};

	aliases {
		led0 = &led_red;
		led1 = &led_green;
		led2 = &led_blue;
		sw0 = &button_middle;
		sw1 = &button_pairing;
	};
};

/* Crystal marked "NSK B 26TAG": assumed 26 MHz. Fallback: HSI (16 MHz) with div-m = 8. */
&clk_hse {
	clock-frequency = <DT_FREQ_M(26)>;
	status = "okay";
};

/* 26 MHz / 13 = 2 MHz, x96 = 192 MHz VCO, /2 = 96 MHz SYSCLK, /4 = 48 MHz */
&pll {
	div-m = <13>;
	mul-n = <96>;
	div-p = <2>;
	div-q = <4>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(96)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <2>;
	apb2-prescaler = <1>;
};

/* Console on the bottom test pad wired to PB6. TX only: PB7 not traced */
&usart1 {
	pinctrl-0 = <&usart1_tx_pb6>;
	pinctrl-names = "default";
	current-speed = <2000000>;
	status = "okay";
};

/* Optotriac cathode switch: keep it off until firmware drives the triac */
&gpioc {
	opto_cathode_off {
		gpio-hog;
		gpios = <6 GPIO_ACTIVE_HIGH>;
		output-low;
	};
};

/* AP6212 Bluetooth, H4 at the controller default 115200 */
&usart2 {
	pinctrl-0 = <&usart2_tx_pa2 &usart2_rx_pa3 &usart2_rts_pa1 &usart2_cts_pa0>;
	pinctrl-names = "default";
	current-speed = <115200>;
	hw-flow-control;
	status = "okay";

	bt_hci_uart: bt_hci_uart {
		compatible = "zephyr,bt-hci-uart";
		status = "okay";

		bt-hci {
			compatible = "infineon,bt-hci-uart";
			status = "okay";
			bt-reg-on-gpios = <&gpioc 5 GPIO_ACTIVE_HIGH>;
		};
	};
};

/* 32.768 kHz LPO on PB10. 96 MHz / 2929 = 32776 Hz (+240 ppm): no exact divider */
&timers2 {
	st,prescaler = <0>;
	status = "okay";

	pwm2: pwm {
		pinctrl-0 = <&tim2_ch3_pb10>;
		pinctrl-names = "default";
		status = "okay";
	};
};

/* USB connector, for the cdc-acm-console snippet. 48 MHz comes from PLLQ */
zephyr_udc0: &usbotg_fs {
	pinctrl-0 = <&usb_otg_fs_dm_pa11 &usb_otg_fs_dp_pa12>;
	pinctrl-names = "default";
	status = "okay";
};

/* AT25SF641 on SPI1. SPI1 sits on APB2 (96 MHz). Start low until wiring is confirmed */
&spi1 {
	pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pa6 &spi1_mosi_pa7>;
	pinctrl-names = "default";
	cs-gpios = <&gpioa 4 GPIO_ACTIVE_LOW>;
	status = "okay";

	spi_flash: flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(8)>;
		size = <DT_SIZE_M(64)>; /* bits */
		jedec-id = [1f 32 17];

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/* Settings (Bluetooth bonds): 16 erase sectors of 4 KiB */
			storage_partition: partition@0 {
				label = "storage";
				reg = <0x0 DT_SIZE_K(64)>;
			};
		};
	};
};

/* Entropy source (Bluetooth host), clocked by PLLQ 48 MHz */
&rng {
	status = "okay";
};

if BOARD_NATIVE_SIM_NATIVE_INTUITIV

# Settings backend: NVS on the simulated SPI NOR, as on the board
config FLASH
	default y

config FLASH_MAP
	default y

config NVS
	default y if SETTINGS

config SETTINGS_NVS_SECTOR_COUNT
	default 16

endif # BOARD_NATIVE_SIM_NATIVE_INTUITIV
